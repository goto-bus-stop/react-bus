{
  "name": "react-bus",
  "description": "A global event emitter for react.",
  "version": "4.0.0",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "dist/index.d.mts",
      "require": "dist/index.js",
      "default": "dist/index.mjs"
    }
  },
  "author": "Renée Kooi <renee@kooi.me>",
  "bugs": {
    "url": "https://github.com/goto-bus-stop/react-bus/issues"
  },
  "dependencies": {
    "@types/react": "^18.0.8",
    "mitt": "^3.0.1"
  },
  "peerDependencies": {
    "react": ">=17.0.0 || ^19.0.0-0"
  },
  "devDependencies": {
    "min-react-env": "^2.0.0",
    "react": "^18.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.1.0",
    "typescript": "^5.0.2"
  },
  "homepage": "https://github.com/goto-bus-stop/react-bus#readme",
  "keywords": [
    "bus",
    "event-emitter",
    "eventemitter",
    "pubsub",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goto-bus-stop/react-bus.git"
  },
  "scripts": {
    "build": "tsup --format=esm --format=cjs --dts index.tsx index.tsx",
    "prepare": "npm run build",
    "test": "node --test"
  }
}
